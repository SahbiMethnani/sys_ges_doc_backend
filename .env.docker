# === MySQL (service Docker "mysql") ===
DATABASE_URL=mysql+pymysql://root:root@mysql:3306/sys_ges_doc

# === JWT ===
JWT_SECRET=changez-ce-secret-en-production-sys-ges-doc-2026
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# === LDAP (service Docker "openldap") ===
LDAP_SERVER=ldap://openldap
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=dc=sysgesdoc,dc=local
LDAP_BIND_DN=cn=admin,dc=sysgesdoc,dc=local
LDAP_BIND_PASSWORD=admin
LDAP_USER_SEARCH_BASE=ou=users,dc=sysgesdoc,dc=local
LDAP_USER_SEARCH_FILTER=(uid={username})
LDAP_ORGANISATION=SysGesDoc

# === Compte admin initial ===
SEED_ADMIN_USERNAME=Sahbi
SEED_ADMIN_DISPLAY_NAME=Sahbi Admin

# === LLM / Embeddings (Docker) ===
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=mistral
EMBEDDING_DEVICE=cpu

# === Stockage RAG ===
LANCE_DB_PATH=/app/lance_db
DOCUMENTS_FOLDER=/app/documents
