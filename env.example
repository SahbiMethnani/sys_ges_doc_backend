# Copiez ce fichier vers .env et adaptez les valeurs

DATABASE_URL=mysql+pymysql://root:root@localhost:3306/sys_ges_doc

JWT_SECRET=changez-ce-secret-en-production
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

LDAP_SERVER=ldap://localhost
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=dc=sysgesdoc,dc=local
LDAP_BIND_DN=cn=admin,dc=sysgesdoc,dc=local
LDAP_BIND_PASSWORD=admin
LDAP_USER_SEARCH_BASE=ou=users,dc=sysgesdoc,dc=local
LDAP_USER_SEARCH_FILTER=(uid={username})

# Interface web consultation LDAP (phpLDAPadmin, après docker compose)
LDAP_UI_URL=http://localhost:8081

SEED_ADMIN_USERNAME=Sahbi
SEED_ADMIN_DISPLAY_NAME=Sahbi Admin

# AUTH_DISABLED=true

# Réinitialisation de mot de passe par e-mail (SMTP gratuit possible)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_URL=http://localhost:4200/reset-password
PASSWORD_RESET_EXPIRE_MINUTES=15
